{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marcas humanas de interés (data/feedback/interest.json)",
  "description": "Campo humano: lo escribe solo la persona responsable desde el portal local. El agente lo lee, nunca lo modifica.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["item_id", "interesting", "date"],
    "additionalProperties": false,
    "properties": {
      "item_id": {"type": "string", "pattern": "^P-\\d{4}-\\d{2}-[FC]?\\d{4}$"},
      "interesting": {"type": "boolean"},
      "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }
  }
}
